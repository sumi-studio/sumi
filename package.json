{
  "name": "sumi",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "bash scripts/dev/real-stack",
    "dev:check": "bash scripts/dev/real-stack --check",
    "dev:workspaces": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check . && turbo run lint",
    "check-types": "turbo run check-types",
    "test": "pnpm run test:operability && turbo run test",
    "test:operability": "node --test scripts/dev/real-stack-static.test.mjs scripts/dev/compose-stack.test.mjs",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "turbo": "^2.10.5"
  }
}
