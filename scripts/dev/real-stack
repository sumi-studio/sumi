#!/usr/bin/env bash
set -Eeuo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly REPOSITORY_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
readonly DEFAULT_ENV_FILE="${REPOSITORY_ROOT}/deploy/local/.env.local"
readonly DEV_POOL_LISTEN_DEFAULT="127.0.0.1:8083"
readonly WEB_PORT_DEFAULT=5173
readonly POSTGRES_COMPOSE_FILE="${REPOSITORY_ROOT}/deploy/local/compose.yaml"
readonly COMPOSE_POSTGRES_DB_URL="postgres://sumi:sumi-dev@127.0.0.1:5432/sumi?sslmode=disable"

ENV_FILE="${SUMI_LOCAL_ENV_FILE:-${DEFAULT_ENV_FILE}}"
CHECK_ONLY=0
RUNTIME_ROOT=
PUBLIC_HOST=
API_PORT=
API_ORIGIN=
WEB_ORIGIN=
WEB_PORT=
declare -a CHILD_PIDS=()

log() {
  printf '[sumi-local] %s\n' "$*" >&2
}

fail() {
  log "ERROR: $*"
  exit 1
}

usage() {
  cat <<'EOF'
Usage: scripts/dev/real-stack [--check] [--env-file PATH]

Starts the real local Sumi API, the secretary runtime, and the Vite frontend.
The Core pool runs each secretary on the
TypeScript core (apps/core) driven by the API's wake sweep, with Messaging
and Direct Chat served through the durable core state service.
--check validates credentials and identity configuration
without building or starting processes.
EOF
}

while (($# > 0)); do
  case "$1" in
    --check)
      CHECK_ONLY=1
      ;;
    --env-file)
      (($# >= 2)) || fail "--env-file requires a path"
      ENV_FILE="$2"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      fail "unknown argument: $1"
      ;;
  esac
  shift
done


load_env_file() {
  local file="$1"
  local line key value mode
  [[ -f "${file}" && -r "${file}" && ! -L "${file}" ]] ||
    fail "configuration file must be a readable regular non-symlink: ${file}"
  mode="$(stat -c '%a' -- "${file}")" ||
    fail "cannot inspect configuration file permissions: ${file}"
  mode="${mode: -3}"
  [[ "${mode}" =~ ^[0-7]{3}$ ]] ||
    fail "cannot parse configuration file permissions: ${file}"
  [[ "${mode:1:1}" =~ ^[0-3]$ && "${mode:2:1}" =~ ^[0-3]$ ]] ||
    fail "configuration file must not be readable by group or other: ${file}"
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%$'\r'}"
    [[ "${line}" =~ ^[[:space:]]*$ || "${line}" =~ ^[[:space:]]*# ]] && continue
    [[ "${line}" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] ||
      fail "invalid literal KEY=VALUE record in ${file}"
    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"
    if [[ "${value}" == \"* || "${value}" == \'* ]]; then
      fail "${file} uses quotes for ${key}; values are parsed literally and must be unquoted"
    fi
    if ! [[ -v "${key}" ]]; then
      printf -v "${key}" '%s' "${value}"
      export "${key}"
    fi
  done < "${file}"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required"
}

require_value() {
  local name="$1"
  [[ -n "${!name:-}" ]] || fail "${name} is required"
}

# Prepares the one directory whose contents outlive a run. The launcher owns
# only the directory it creates itself: a root that already exists may have
# other duties (${HOME}, ${TMPDIR}), so its mode is verified and never forced,
# because fitting it to 0700 would strip access the rest of the system relies
# on. The root must also be absolute, since the API resolves
# SUMI_MESSAGING_ATTACHMENT_ROOT against its own working directory (apps/api)
# rather than the one make dev was invoked from: a relative root would have the
# launcher provision one parent while the API demands another, and would move
# the store whenever the stack is started from somewhere else.
validate_persistent_state_root_ancestors() {
  local root="$1" ancestor metadata mode owner reason
  ancestor="$(dirname -- "${root}")"
  while :; do
    metadata="$(stat -c '%a %u' -- "${ancestor}")" ||
      fail "cannot inspect an ancestor of the persistent local state root: ${ancestor}"
    mode="${metadata%% *}"
    owner="${metadata##* }"
    reason=""
    if [[ "${owner}" != "${UID}" && "${owner}" != "0" ]]; then
      reason="owner uid ${owner} is neither uid ${UID} nor root"
    fi
    if [[ "${mode: -2:1}" =~ [2367] || "${mode: -1}" =~ [2367] ]]; then
      if (( (8#${mode} & 8#1000) == 0 )); then
        [[ -z "${reason}" ]] || reason+="; "
        reason+="is writable by group or other and is not sticky"
      fi
    fi
    [[ -z "${reason}" ]] ||
      fail "the persistent local state root is unsafe: ancestor ${ancestor} ${reason}"
    [[ "${ancestor}" == "/" ]] && return 0
    ancestor="$(dirname -- "${ancestor}")"
  done
}

provision_persistent_state_root() {
  local root="$1" canonical_root metadata mode owner
  # Normalize trailing separators once before every subsequent path check.
  # In particular, -L follows a symlink when its operand has a trailing slash.
  while [[ "${root}" != "/" && "${root}" == */ ]]; do
    root="${root%/}"
  done
  [[ "${root}" == /* ]] ||
    fail "the persistent local state root must be an absolute path; fix SUMI_REAL_STACK_STATE_ROOT or XDG_STATE_HOME: ${root}"
  (umask 077; mkdir -p -- "$(dirname -- "${root}")") ||
    fail "cannot create the parent of the persistent local state root: ${root}"
  # mkdir without -p reports the difference between "created for us" and
  # "already there", which is exactly the line the launcher must not cross.
  if [[ ! -e "${root}" && ! -L "${root}" ]]; then
    mkdir -m 0700 -- "${root}" ||
      fail "cannot create the persistent local state root: ${root}"
  fi
  [[ -d "${root}" && ! -L "${root}" ]] ||
    fail "the persistent local state root must be a real directory: ${root}"
  metadata="$(stat -c '%a %u' -- "${root}")" ||
    fail "cannot inspect the persistent local state root: ${root}"
  mode="${metadata%% *}"
  owner="${metadata##* }"
  [[ "${mode: -3}" == 700 && "${owner}" == "${UID}" ]] ||
    fail "the persistent local state root already exists as mode ${mode} owned by uid ${owner}; it must be a private directory of this user (mode 0700, uid ${UID}) before it can hold attachments: ${root}"
  # Resolve every ancestor once after the root exists and its own symlink
  # check has passed. From here on, use this stable real path only: a later
  # replacement of an ancestor link cannot redirect the API to unchecked data.
  canonical_root="$(realpath -e -- "${root}")" ||
    fail "cannot resolve the persistent local state root: ${root}"
  validate_persistent_state_root_ancestors "${canonical_root}"
  printf '%s\n' "${canonical_root}"
}


valid_binding_id() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$ ]]
}

validate_firebase_web_config() {
  local configured=0 name
  for name in \
    VITE_FIREBASE_API_KEY \
    VITE_FIREBASE_AUTH_DOMAIN \
    VITE_FIREBASE_PROJECT_ID \
    VITE_FIREBASE_APP_ID
  do
    [[ -n "${!name:-}" ]] && configured=1
  done
  if ((configured)); then
    for name in \
      VITE_FIREBASE_API_KEY \
      VITE_FIREBASE_AUTH_DOMAIN \
      VITE_FIREBASE_PROJECT_ID \
      VITE_FIREBASE_APP_ID
    do
      require_value "${name}"
    done
  fi
}

validate_web_port() {
  WEB_PORT="${SUMI_DEV_WEB_PORT:-${WEB_PORT_DEFAULT}}"
  export WEB_PORT
  [[ "${WEB_PORT}" =~ ^[0-9]{1,5}$ ]] ||
    fail "SUMI_DEV_WEB_PORT must be a decimal port (got ${WEB_PORT})"
  ((10#${WEB_PORT} >= 1 && 10#${WEB_PORT} <= 65535)) ||
    fail "SUMI_DEV_WEB_PORT is outside 1..65535"
  [[ "${WEB_PORT}" != "8081" && "${WEB_PORT}" != "8082" ]] ||
    fail "SUMI_DEV_WEB_PORT collides with a reserved local-stack port"
    local pool_port="${DEV_POOL_LISTEN##*:}"
    [[ "${WEB_PORT}" != "${pool_port}" ]] ||
      fail "SUMI_DEV_WEB_PORT collides with the dev core pool port"
}

validate_dev_pool_listen() {
  DEV_POOL_LISTEN="${SUMI_DEV_POOL_LISTEN:-${DEV_POOL_LISTEN_DEFAULT}}"
  export DEV_POOL_LISTEN
  [[ "${DEV_POOL_LISTEN}" =~ ^(127\.0\.0\.1):([0-9]{1,5})$ ]] ||
    fail "SUMI_DEV_POOL_LISTEN must be a 127.0.0.1:port loopback address (got ${DEV_POOL_LISTEN})"
}

validate_public_listen() {
  SUMI_PUBLIC_LISTEN="${SUMI_PUBLIC_LISTEN:-127.0.0.1:8080}"
  export SUMI_PUBLIC_LISTEN
  [[ "${SUMI_PUBLIC_LISTEN}" =~ ^([0-9]{1,3}(\.[0-9]{1,3}){3}):([0-9]{1,5})$ ]] ||
    fail "SUMI_PUBLIC_LISTEN must be a literal IPv4 address and port"
  PUBLIC_HOST="${BASH_REMATCH[1]}"
  API_PORT="${BASH_REMATCH[3]}"
  ((10#${API_PORT} > 0 && 10#${API_PORT} <= 65535)) ||
    fail "SUMI_PUBLIC_LISTEN port is outside 1..65535"
  [[ "${PUBLIC_HOST}" != "0.0.0.0" ]] ||
    fail "SUMI_PUBLIC_LISTEN must not expose an all-interface wildcard"
  [[ "${API_PORT}" != "8081" && "${API_PORT}" != "8082" && "${API_PORT}" != "${WEB_PORT}" ]] ||
    fail "SUMI_PUBLIC_LISTEN collides with a reserved local-stack port"
    local pool_port="${DEV_POOL_LISTEN##*:}"
    [[ "${API_PORT}" != "${pool_port}" ]] ||
      fail "SUMI_PUBLIC_LISTEN collides with the dev core pool port"
  if [[ "${PUBLIC_HOST}" != "127.0.0.1" ]]; then
    node -e '
      const octets = process.argv[1].split(".").map(Number);
      if (
        octets.length !== 4 ||
        octets[0] !== 100 ||
        octets[1] < 64 ||
        octets[1] > 127
      ) process.exit(2);
    ' "${PUBLIC_HOST}" ||
      fail "SUMI_PUBLIC_LISTEN must use 127.0.0.1 or an assigned Tailnet IPv4 in 100.64.0.0/10"
  fi
  node -e '
    const { createServer, isIP } = require("node:net");
    const address = process.argv[1];
    if (isIP(address) !== 4) process.exit(2);
    const server = createServer();
    server.once("error", () => process.exit(3));
    server.listen({ host: address, port: 0, exclusive: true }, () => {
      server.close((error) => process.exit(error ? 4 : 0));
    });
  ' "${PUBLIC_HOST}" ||
    fail "SUMI_PUBLIC_LISTEN address cannot be bound by a local process"
  API_ORIGIN="http://${PUBLIC_HOST}:${API_PORT}"
  WEB_ORIGIN="http://${PUBLIC_HOST}:${WEB_PORT}"
}

validate_adc() {
  local credential_file credential_metadata credential_project credential_email
  if [[ -n "${GOOGLE_APPLICATION_CREDENTIALS:-}" ]]; then
    credential_file="$(realpath -- "${GOOGLE_APPLICATION_CREDENTIALS}")" ||
      fail "cannot resolve GOOGLE_APPLICATION_CREDENTIALS"
    [[ -f "${credential_file}" && -r "${credential_file}" && ! -L "${credential_file}" ]] ||
      fail "GOOGLE_APPLICATION_CREDENTIALS must be a readable regular non-symlink"
    credential_metadata="$(
      node -e '
        const fs = require("node:fs");
        const value = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
        if (
          typeof value.project_id !== "string" ||
          typeof value.client_email !== "string" ||
          typeof value.private_key !== "string" ||
          !value.project_id ||
          !value.client_email ||
          !value.private_key
        ) process.exit(2);
        process.stdout.write(`${value.project_id}\t${value.client_email}`);
      ' "${credential_file}"
    )" || fail "GOOGLE_APPLICATION_CREDENTIALS is not a usable service-account ADC file"
    IFS=$'\t' read -r credential_project credential_email <<< "${credential_metadata}"
    [[ "${credential_project}" == "${SUMI_AUTH_FIREBASE_PROJECT_ID}" ]] ||
      fail "Firebase Admin ADC project must match SUMI_AUTH_FIREBASE_PROJECT_ID"
    [[ "${credential_email}" == *@*.gserviceaccount.com ]] ||
      fail "Firebase Admin ADC client_email is not a service account"
    GOOGLE_APPLICATION_CREDENTIALS="${credential_file}"
    export GOOGLE_APPLICATION_CREDENTIALS
    return
  fi

  require_command gcloud
  gcloud auth application-default print-access-token >/dev/null 2>&1 ||
    fail "Google Application Default Credentials are unavailable; run gcloud auth application-default login"
  credential_project="$(gcloud config get-value project 2>/dev/null || true)"
  [[ -n "${credential_project}" && "${credential_project}" != "(unset)" ]] ||
    fail "gcloud has no active project for Firebase Admin ADC"
  [[ "${credential_project}" == "${SUMI_AUTH_FIREBASE_PROJECT_ID}" ]] ||
    fail "gcloud project must match SUMI_AUTH_FIREBASE_PROJECT_ID"
}

validate_firebase_admin_mode() {
  local api_emulator="${FIREBASE_AUTH_EMULATOR_HOST:-}"
  local web_emulator="${VITE_FIREBASE_AUTH_EMULATOR_URL:-}"
  if [[ -z "${api_emulator}" && -z "${web_emulator}" ]]; then
    validate_adc
    return
  fi
  [[ -n "${api_emulator}" && -n "${web_emulator}" ]] ||
    fail "Firebase Auth emulator requires both FIREBASE_AUTH_EMULATOR_HOST and VITE_FIREBASE_AUTH_EMULATOR_URL"
  node -e '
    const { isIP } = require("node:net");
    const api = process.argv[1];
    const web = process.argv[2];
    const publicHost = process.argv[3];
    const match = api.match(/^([0-9.]+):([0-9]{1,5})$/);
    if (!match || isIP(match[1]) !== 4 || match[1] === "0.0.0.0") process.exit(2);
    const port = Number(match[2]);
    if (!Number.isInteger(port) || port < 1 || port > 65535) process.exit(3);
    try {
      const url = new URL(web);
      if (
        url.origin !== web ||
        url.protocol !== "http:" ||
        isIP(url.hostname) !== 4 ||
        url.hostname === "0.0.0.0"
      ) process.exit(4);
      if (publicHost !== "127.0.0.1" && url.hostname !== publicHost) {
        process.exit(6);
      }
    } catch {
      process.exit(5);
    }
  ' "${api_emulator}" "${web_emulator}" "${PUBLIC_HOST}" ||
    fail "Firebase Auth emulator endpoints must be exact literal-IPv4 HTTP endpoints, and the browser endpoint must use the public Tailnet host"
}


# The core runtime resolves the model provider per persona from
# apps/core/src/host/provider-env.ts: mock (the default, deterministic and
# network-free), fixture (scripted rules for bounded integration checks),
# openai (an OpenAI-compatible endpoint — local stubs need no real key), or
# none (no model; durable tools still run). A persona's selected model
# connection in the app overrides these environment settings.
validate_core_runtime_configuration() {
  local provider="${SUMI_MODEL_PROVIDER:-mock}"
  case "${provider}" in
    mock | none) ;;
    openai)
      for name in SUMI_MODEL_BASE_URL SUMI_MODEL_API_KEY SUMI_MODEL_MODEL; do
        require_value "${name}"
      done
      ;;
    fixture)
      if [[ -n "${SUMI_MODEL_FIXTURE:-}" ]]; then
        [[ -f "${SUMI_MODEL_FIXTURE}" ]] ||
          fail "SUMI_MODEL_FIXTURE is not a readable file: ${SUMI_MODEL_FIXTURE}"
      else
        require_value SUMI_MODEL_FIXTURE_JSON
      fi
      ;;
    *)
      fail "SUMI_MODEL_PROVIDER must be mock, fixture, openai, or none (got ${provider})"
      ;;
  esac
}

validate_configuration() {
  local web_project
  validate_dev_pool_listen
  validate_web_port
  validate_public_listen

  for name in \
    SUMI_AUTH_FIREBASE_PROJECT_ID \
    SUMI_AUTH_TENANT_ID
  do
    require_value "${name}"
  done
  valid_binding_id "${SUMI_AUTH_TENANT_ID}" ||
    fail "SUMI_AUTH_TENANT_ID is not a valid Sumi binding ID"
  if [[ -n "${SUMI_AUTH_FIREBASE_TENANT_ID:-}" ]]; then
    ((${#SUMI_AUTH_FIREBASE_TENANT_ID} <= 128)) ||
      fail "SUMI_AUTH_FIREBASE_TENANT_ID exceeds 128 bytes"
  fi

  validate_firebase_web_config
  web_project="${VITE_FIREBASE_PROJECT_ID:-sumi-studio}"
  [[ "${web_project}" == "${SUMI_AUTH_FIREBASE_PROJECT_ID}" ]] ||
    fail "Firebase web and Admin project IDs must match"

  validate_firebase_admin_mode
  validate_core_runtime_configuration
}

process_is_running() {
  kill -0 "$1" 2>/dev/null
}

signal_process_tree() {
  local signal="$1"
  local pid="$2"
  process_is_running "${pid}" || return 0
  kill "-${signal}" -- "-${pid}" 2>/dev/null ||
    kill "-${signal}" "${pid}" 2>/dev/null ||
    true
}

wait_for_http() {
  local url="$1"
  local pid="$2"
  local label="$3"
  local attempt
  for attempt in {1..200}; do
    process_is_running "${pid}" || fail "${label} exited before readiness"
    if curl --fail --silent --show-error --max-time 1 "${url}" >/dev/null 2>&1; then
      return
    fi
    sleep 0.1
  done
  fail "timed out waiting for ${label}"
}

assert_exact_tcp_listener() {
  local expected="$1"
  local port="$2"
  local label="$3"
  local listener found=0
  while IFS= read -r listener; do
    [[ -n "${listener}" ]] || continue
    case "${listener}" in
      "*:${port}" | "0.0.0.0:${port}" | "[::]:${port}")
        fail "${label} widened to an all-interface listener"
        ;;
    esac
    [[ "${listener}" == "${expected}" ]] && found=1
  done < <(ss -H -ltn "sport = :${port}" | awk '{print $4}')
  ((found == 1)) || fail "${label} did not bind exact address ${expected}"
}


start_postgres() {
  if [[ -n "${POSTGRES_DB_URL_OVERRIDE}" ]]; then
    # An already configured owned database (for example a developer-managed
    # instance) replaces the compose-managed one. The API still enforces its
    # own connectivity and migrations; here we only prove the endpoint
    # answers before builds start.
    log "using configured development database instead of compose Postgres"
    node -e '
      const net = require("node:net");
      const url = new URL(process.argv[1]);
      const socket = net.connect({ host: url.hostname, port: Number(url.port || 5432) });
      const timer = setTimeout(() => { socket.destroy(); process.exit(1); }, 5000);
      socket.on("connect", () => { clearTimeout(timer); socket.end(); });
      socket.on("error", () => { clearTimeout(timer); process.exit(1); });
    ' "${POSTGRES_DB_URL}" || fail "configured database ${POSTGRES_DB_URL} is not reachable"
    return
  fi
  log "starting control-plane Postgres via compose"
  docker compose -f "${POSTGRES_COMPOSE_FILE}" up -d postgres >/dev/null
  local attempt
  for attempt in {1..300}; do
    if docker compose -f "${POSTGRES_COMPOSE_FILE}" exec -T postgres \
      pg_isready -U sumi -d sumi >/dev/null 2>&1; then
      return
    fi
    sleep 0.2
  done
  fail "timed out waiting for control-plane Postgres"
}


# The dev pool is the Local-development half of the Cloud wake contract: the
# API's wake sweep POSTs {SUMI_DEV_POOL_LISTEN}/personas/{id}/wake, and the
# pool runs one apps/core/src/host/local.ts child per persona against the
# state service. The writer lease in Postgres — not this process — is what
# keeps a persona to one operative execution owner.
start_dev_pool() {
  log "starting dev core pool (TypeScript secretary host)"
  declare -a pool_environment=(
    "PATH=${PATH}"
    "HOME=${AGENT_STATE_DIR}"
    "LANG=C.UTF-8"
    "SUMI_STATE_URL=${API_ORIGIN}"
    "SUMI_DEV_POOL_LISTEN=${DEV_POOL_LISTEN}"
    "SUMI_CORE_WAKE_TOKEN=${SUMI_CORE_WAKE_TOKEN}"
    "SUMI_CORE_RUNTIME_TOKEN=${SUMI_CORE_RUNTIME_TOKEN}"
    "SUMI_MODEL_PROVIDER=${SUMI_MODEL_PROVIDER:-mock}"
  )
  for name in \
    SUMI_MODEL_BASE_URL \
    SUMI_MODEL_API_KEY \
    SUMI_MODEL_MODEL \
    SUMI_MODEL_HEADERS_JSON \
    SUMI_MODEL_EXTRA_JSON \
    SUMI_MODEL_TIMEOUT_MS \
    SUMI_MODEL_FIXTURE \
    SUMI_MODEL_FIXTURE_JSON \
    SUMI_LEASE_TTL_MS \
    SUMI_PROVIDER_RETRY_BUDGET_MS \
    SUMI_MEMORY_PREPARATION_TIMEOUT_MS \
    SUMI_MEMORY_UNAVAILABLE_PAUSE_MS
  do
    if [[ -n "${!name:-}" ]]; then
      pool_environment+=("${name}=${!name}")
    fi
  done
  (
    cd "${REPOSITORY_ROOT}/apps/core"
    exec setsid env -i \
      "${pool_environment[@]}" \
      node src/host/dev-pool.ts
  ) >"${LOG_DIR}/dev-pool.log" 2>&1 &
  DEV_POOL_PID=$!
  CHILD_PIDS+=("${DEV_POOL_PID}")
  wait_for_http "http://${DEV_POOL_LISTEN}/health" "${DEV_POOL_PID}" "dev core pool"
  assert_exact_tcp_listener "${DEV_POOL_LISTEN}" "${DEV_POOL_LISTEN##*:}" "dev core pool"
}


random_base64() {
  openssl rand -base64 48 | tr -d '\n'
}

random_token() {
  openssl rand -hex 32
}

cleanup() {
  local status=$?
  local index pid attempt
  trap - EXIT INT TERM
  for ((index = ${#CHILD_PIDS[@]} - 1; index >= 0; index--)); do
    pid="${CHILD_PIDS[index]}"
    signal_process_tree TERM "${pid}"
  done
  for attempt in {1..50}; do
    local live=0
    for pid in "${CHILD_PIDS[@]}"; do
      process_is_running "${pid}" && live=1
    done
    ((live == 0)) && break
    sleep 0.1
  done
  for pid in "${CHILD_PIDS[@]}"; do
    signal_process_tree KILL "${pid}"
    wait "${pid}" 2>/dev/null || true
  done
  if [[ -n "${RUNTIME_ROOT}" && -d "${RUNTIME_ROOT}" ]]; then
    local runtime_parent runtime_name temporary_root
    runtime_parent="$(realpath -m -- "$(dirname -- "${RUNTIME_ROOT}")")"
    runtime_name="$(basename -- "${RUNTIME_ROOT}")"
    temporary_root="$(realpath -m -- "${TMPDIR:-/tmp}")"
    if [[ "${runtime_parent}" == "${temporary_root}" && "${runtime_name}" == sumi-real-stack.* ]]; then
      rm -rf -- "${RUNTIME_ROOT}"
    else
      log "refusing to remove unexpected runtime path: ${RUNTIME_ROOT}"
      status=1
    fi
  fi
  exit "${status}"
}

for command in node realpath stat; do
  require_command "${command}"
done
load_env_file "${ENV_FILE}"
validate_configuration
if ((CHECK_ONLY)); then
  log "configuration is valid (Firebase/provider credentials were not printed)"
  exit 0
fi

# An owned, already running database may replace the compose-managed one for
# development; the API still validates connectivity itself on startup.
readonly POSTGRES_DB_URL_OVERRIDE="${SUMI_DEV_DATABASE_URL:-}"
readonly POSTGRES_DB_URL="${POSTGRES_DB_URL_OVERRIDE:-${COMPOSE_POSTGRES_DB_URL}}"

for command in awk curl flock go openssl pnpm setsid ss; do
  require_command "${command}"
done
if [[ -z "${POSTGRES_DB_URL_OVERRIDE}" ]]; then
  require_command docker
fi
  node -e 'const [a, b] = process.versions.node.split(".").map(Number); process.exit(a > 22 || (a === 22 && b >= 18) ? 0 : 1)' ||
    fail "the dev core pool runs TypeScript directly and needs Node.js 22.18 or newer"
[[ -x "${REPOSITORY_ROOT}/apps/web/node_modules/vite/bin/vite.js" ]] ||
  fail "web dependencies are missing; run make setup first"

exec 9>"${TMPDIR:-/tmp}/sumi-real-stack-${UID}.lock"
flock -n 9 || fail "another local Sumi stack owns the fixed development ports"

RUNTIME_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/sumi-real-stack.XXXXXXXX")"
chmod 0700 "${RUNTIME_ROOT}"
trap cleanup EXIT INT TERM

# Attachment bytes have to outlive one run. Postgres keeps the rows that name
# them in a named Compose volume, so holding the bytes under the disposable
# runtime root left the database pointing at files that shutdown had already
# deleted: attachments then referred to missing objects after every restart.
# The persistent root sits under the user state directory instead. Resolve it
# once after provisioning so both validation and the API use one real path.
readonly CONFIGURED_PERSISTENT_STATE_ROOT="${SUMI_REAL_STACK_STATE_ROOT:-${XDG_STATE_HOME:-${HOME}/.local/state}/sumi/real-stack}"
PERSISTENT_STATE_ROOT="$(provision_persistent_state_root "${CONFIGURED_PERSISTENT_STATE_ROOT}")"
readonly PERSISTENT_STATE_ROOT
if [[ "${PERSISTENT_STATE_ROOT}" != "${CONFIGURED_PERSISTENT_STATE_ROOT}" ]]; then
  log "persistent local state root normalized: configured ${CONFIGURED_PERSISTENT_STATE_ROOT}; using ${PERSISTENT_STATE_ROOT}"
fi
readonly COMMAND_LOG_DIR="${PERSISTENT_STATE_ROOT}/command-log"
readonly GATEWAY_STATE_DIR="${PERSISTENT_STATE_ROOT}/browser-events"
readonly MESSAGING_ATTACHMENT_DIR="${PERSISTENT_STATE_ROOT}/messaging-attachments"
# Local runs use explicit bounded attachment caps; the API refuses to serve
# attachments unless every Workspace and store-wide byte/object cap is set.
readonly MESSAGING_ATTACHMENT_WORKSPACE_QUOTA_BYTES="${SUMI_MESSAGING_ATTACHMENT_WORKSPACE_QUOTA_BYTES:-268435456}"
readonly MESSAGING_ATTACHMENT_WORKSPACE_QUOTA_OBJECTS="${SUMI_MESSAGING_ATTACHMENT_WORKSPACE_QUOTA_OBJECTS:-5000}"
readonly MESSAGING_ATTACHMENT_TOTAL_QUOTA_BYTES="${SUMI_MESSAGING_ATTACHMENT_TOTAL_QUOTA_BYTES:-1073741824}"
readonly MESSAGING_ATTACHMENT_TOTAL_QUOTA_OBJECTS="${SUMI_MESSAGING_ATTACHMENT_TOTAL_QUOTA_OBJECTS:-25000}"
# VAPID keys are deployment-owned and persisted in Postgres. The local subject
# is only the standards-required operator contact carried in the signed push
# request; no message content is configured here.
readonly MESSAGING_PUSH_SUBJECT="${SUMI_MESSAGING_PUSH_SUBJECT:-mailto:dev@sumi.local}"
readonly LOG_DIR="${RUNTIME_ROOT}/logs"
readonly BIN_DIR="${RUNTIME_ROOT}/bin"
provision_persistent_state_root "${COMMAND_LOG_DIR}" >/dev/null
provision_persistent_state_root "${GATEWAY_STATE_DIR}" >/dev/null
mkdir -m 0700 \
  "${LOG_DIR}" \
  "${BIN_DIR}"
readonly API_BINARY="${BIN_DIR}/sumi-api"

log "building the Go API"
(
  cd "${REPOSITORY_ROOT}/apps/api"
  go build -o "${API_BINARY}" ./cmd/server
)

start_postgres

# An externally supplied session secret lets owned e2e fixtures (for example
# cmd/e2e-session-cookie) mint browser sessions against the launched stack.
SUMI_BROWSER_SESSION_SECRET="${SUMI_BROWSER_SESSION_SECRET:-$(random_base64)}"

  # The API mounts /internal/core on this token; the dev pool's children
  # authenticate to persona-scoped routes with the runtime credential, and
  # the API's wake sweep authenticates to the pool with the wake token —
  # the same credential split Cloud uses for its core host.
  SUMI_CORE_STATE_TOKEN="$(random_token)"
  SUMI_CORE_RUNTIME_TOKEN="$(random_token)"
  SUMI_CORE_WAKE_TOKEN="$(random_token)"
  readonly SUMI_CORE_STATE_TOKEN SUMI_CORE_RUNTIME_TOKEN SUMI_CORE_WAKE_TOKEN

declare -a adc_environment=("HOME=${HOME}" "GOOGLE_CLOUD_PROJECT=${SUMI_AUTH_FIREBASE_PROJECT_ID}")
if [[ -n "${GOOGLE_APPLICATION_CREDENTIALS:-}" ]]; then
  adc_environment+=("GOOGLE_APPLICATION_CREDENTIALS=${GOOGLE_APPLICATION_CREDENTIALS}")
fi
if [[ -n "${FIREBASE_AUTH_EMULATOR_HOST:-}" ]]; then
  adc_environment+=("FIREBASE_AUTH_EMULATOR_HOST=${FIREBASE_AUTH_EMULATOR_HOST}")
fi

declare -a api_environment=(
  "PORT=${API_PORT}"
  "SUMI_PUBLIC_LISTEN=${SUMI_PUBLIC_LISTEN}"
  "SUMI_COMMAND_LOG_DIR=${COMMAND_LOG_DIR}"
  "SUMI_BROWSER_EVENT_DIR=${GATEWAY_STATE_DIR}"
  "SUMI_MESSAGING_ATTACHMENT_ROOT=${MESSAGING_ATTACHMENT_DIR}"
  "SUMI_MESSAGING_ATTACHMENT_WORKSPACE_QUOTA_BYTES=${MESSAGING_ATTACHMENT_WORKSPACE_QUOTA_BYTES}"
  "SUMI_MESSAGING_ATTACHMENT_WORKSPACE_QUOTA_OBJECTS=${MESSAGING_ATTACHMENT_WORKSPACE_QUOTA_OBJECTS}"
  "SUMI_MESSAGING_ATTACHMENT_TOTAL_QUOTA_BYTES=${MESSAGING_ATTACHMENT_TOTAL_QUOTA_BYTES}"
  "SUMI_MESSAGING_ATTACHMENT_TOTAL_QUOTA_OBJECTS=${MESSAGING_ATTACHMENT_TOTAL_QUOTA_OBJECTS}"
  "SUMI_MESSAGING_PUSH_SUBJECT=${MESSAGING_PUSH_SUBJECT}"
  "SUMI_FEEDBACK_RECIPIENTS=${SUMI_FEEDBACK_RECIPIENTS:-}"
  "SUMI_BROWSER_SESSION_SECRET=${SUMI_BROWSER_SESSION_SECRET}"
  "SUMI_BROWSER_SESSION_AUDIENCE=sumi:web"
  "SUMI_BROWSER_WS_ALLOWED_ORIGINS=${WEB_ORIGIN}"
  "SUMI_AUTH_FIREBASE_TENANT_ID=${SUMI_AUTH_FIREBASE_TENANT_ID:-}"
  "SUMI_AUTH_FIREBASE_PROJECT_ID=${SUMI_AUTH_FIREBASE_PROJECT_ID}"
  "SUMI_AUTH_TENANT_ID=${SUMI_AUTH_TENANT_ID}"
  "SUMI_AUTH_ALLOW_INSECURE_COOKIES=true"
  "SUMI_AUTH_SESSION_TTL=1h"
  "SUMI_DB_URL=${POSTGRES_DB_URL}"
)
  # Mounts /internal/core and the wake sweep, switches Messaging attention to
  # the durable core-input path, and serves Direct Chat commands and replies
  # through the core (see cmd/server/main.go).
  api_environment+=(
    "SUMI_CORE_STATE_TOKEN=${SUMI_CORE_STATE_TOKEN}"
    "SUMI_CORE_RUNTIME_TOKEN=${SUMI_CORE_RUNTIME_TOKEN}"
    "SUMI_CORE_WAKE_URL=http://${DEV_POOL_LISTEN}"
    "SUMI_CORE_WAKE_TOKEN=${SUMI_CORE_WAKE_TOKEN}"
  )

log "starting API"
(
  cd "${REPOSITORY_ROOT}/apps/api"
  exec setsid env -i \
    "PATH=${PATH}" \
    "${adc_environment[@]}" \
    "${api_environment[@]}" \
    "${API_BINARY}"
) >"${LOG_DIR}/api.log" 2>&1 &
API_PID=$!
CHILD_PIDS+=("${API_PID}")
wait_for_http "${API_ORIGIN}/health" "${API_PID}" "API"
assert_exact_tcp_listener "${SUMI_PUBLIC_LISTEN}" "${API_PORT}" "API"

  start_dev_pool

declare -a vite_environment=(
  "PATH=${PATH}"
  "HOME=${HOME}"
  "SUMI_DEV_HOST=${PUBLIC_HOST}"
  "SUMI_DEV_API_ORIGIN=${API_ORIGIN}"
  "SUMI_DEV_PORT=${WEB_PORT}"
)
for name in \
  VITE_FIREBASE_API_KEY \
  VITE_FIREBASE_AUTH_DOMAIN \
  VITE_FIREBASE_PROJECT_ID \
  VITE_FIREBASE_STORAGE_BUCKET \
  VITE_FIREBASE_MESSAGING_SENDER_ID \
  VITE_FIREBASE_APP_ID \
  VITE_FIREBASE_AUTH_EMULATOR_URL
do
  if [[ -n "${!name:-}" ]]; then
    vite_environment+=("${name}=${!name}")
  fi
done

log "starting Vite at ${WEB_ORIGIN}"
(
  cd "${REPOSITORY_ROOT}/apps/web"
  exec setsid env -i \
    "${vite_environment[@]}" \
    node node_modules/vite/bin/vite.js
) >"${LOG_DIR}/vite.log" 2>&1 &
VITE_PID=$!
CHILD_PIDS+=("${VITE_PID}")
wait_for_http "${WEB_ORIGIN}/" "${VITE_PID}" "Vite"
assert_exact_tcp_listener "${PUBLIC_HOST}:${WEB_PORT}" "${WEB_PORT}" "Vite"

log "Sumi is Ready: ${WEB_ORIGIN}"
log "Press Ctrl-C to stop; disposable state and non-production secrets will be removed, while uploaded attachments persist."
while true; do
  for pid in "${CHILD_PIDS[@]}"; do
    process_is_running "${pid}" || fail "a required Sumi process exited"
  done
  sleep 1
done
