#!/usr/bin/env bash
set -Eeuo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly REPOSITORY_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd -P)"
readonly SOURCE_URL="https://github.com/sumi-studio/sumi"
readonly REVISION_LABEL="org.opencontainers.image.revision"
readonly SOURCE_LABEL="org.opencontainers.image.source"

COMMIT=
TAG=
MANIFEST=
DRY_RUN=false
TEMP_MANIFEST=
PRIVATE_BUILD_ROOT=
BUILD_CONTEXT=

declare -a ROLES=(api agent provisioner web)
declare -A REPOSITORIES=(
  [api]="ghcr.io/sumi-studio/sumi-api"
  [agent]="ghcr.io/sumi-studio/sumi-agent"
  [provisioner]="ghcr.io/sumi-studio/sumi-provisioner"
  [web]="ghcr.io/sumi-studio/sumi-web"
)
declare -A DOCKERFILES=(
  [api]="deploy/api/Dockerfile"
  [agent]="deploy/agent/Dockerfile"
  [provisioner]="deploy/provisioner/Dockerfile"
  [web]="deploy/web/Dockerfile"
)
declare -A IMAGE_IDS=()
declare -A IMAGE_DIGEST_JSON=()

log() {
  printf '[sumi-dogfood-images] %s\n' "$*" >&2
}

fail() {
  log "ERROR: $*"
  exit 1
}

usage() {
  cat >&2 <<'EOF'
usage: scripts/operations/build-dogfood-images \
  --commit <full-lowercase-sha> --tag <same-full-lowercase-sha> \
  --manifest <new-path> [--dry-run]

Builds and locally verifies the API, agent, provisioner, and web images. It
never pushes an image and never invokes Docker Compose.
EOF
}

cleanup() {
  if [[ -n "${TEMP_MANIFEST}" && -e "${TEMP_MANIFEST}" ]]; then
    rm -f -- "${TEMP_MANIFEST}"
  fi
  if [[ -n "${PRIVATE_BUILD_ROOT}" && -d "${PRIVATE_BUILD_ROOT}" ]]; then
    if [[ ! -L "${PRIVATE_BUILD_ROOT}" &&
      "${PRIVATE_BUILD_ROOT}" == "${manifest_parent}/.dogfood-build."* &&
      "$(stat -Lc '%u' -- "${PRIVATE_BUILD_ROOT}")" == "$(id -u)" ]]; then
      rm -rf -- "${PRIVATE_BUILD_ROOT}"
    else
      log "ERROR: refusing to clean an untrusted private build root: ${PRIVATE_BUILD_ROOT}"
      return 1
    fi
  fi
}
trap cleanup EXIT

while (($#)); do
  case "$1" in
    --commit)
      (($# >= 2)) || fail "--commit requires a value"
      COMMIT="$2"
      shift 2
      ;;
    --tag)
      (($# >= 2)) || fail "--tag requires a value"
      TAG="$2"
      shift 2
      ;;
    --manifest)
      (($# >= 2)) || fail "--manifest requires a value"
      MANIFEST="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      usage
      fail "unknown argument: $1"
      ;;
  esac
done

[[ "${COMMIT}" =~ ^[0-9a-f]{40}$ ]] || fail "commit must be a full lowercase Git SHA"
[[ "${TAG}" =~ ^[0-9a-f]{40}$ ]] || fail "tag must be a full lowercase Git SHA; floating tags are refused"
[[ "${TAG}" == "${COMMIT}" ]] || fail "tag must exactly equal the source commit"
[[ -n "${MANIFEST}" ]] || fail "--manifest is required"

[[ "$(pwd -P)" == "${REPOSITORY_ROOT}" ]] || fail "run from the repository root: ${REPOSITORY_ROOT}"
[[ "$(git rev-parse --show-toplevel 2>/dev/null)" == "${REPOSITORY_ROOT}" ]] ||
  fail "script path is not inside the active repository root"
[[ "$(git rev-parse HEAD 2>/dev/null)" == "${COMMIT}" ]] || fail "HEAD is not the requested exact commit"
[[ -z "$(git status --porcelain=v1 --untracked-files=all)" ]] || fail "worktree is not clean"
command -v node >/dev/null 2>&1 || fail "node is required to validate the pinned tree and image evidence"

for variable in SUMI_DOGFOOD_IMAGE_TAG SUMI_API_IMAGE_TAG SUMI_AGENT_IMAGE_TAG \
  SUMI_PROVISIONER_IMAGE_TAG SUMI_WEB_IMAGE_TAG; do
  if [[ -n "${!variable:-}" && "${!variable}" != "${TAG}" ]]; then
    fail "${variable} does not match the one exact image tag"
  fi
done

manifest_parent="$(dirname -- "${MANIFEST}")"
manifest_name="$(basename -- "${MANIFEST}")"
[[ "${manifest_name}" != "." && "${manifest_name}" != ".." ]] || fail "manifest must name a file"
[[ -d "${manifest_parent}" ]] || fail "manifest parent directory does not exist"
manifest_parent="$(cd "${manifest_parent}" && pwd -P)" || fail "cannot resolve manifest parent"
MANIFEST="${manifest_parent}/${manifest_name}"
[[ ! -e "${MANIFEST}" && ! -L "${MANIFEST}" ]] || fail "manifest path already exists"
read -r manifest_parent_owner manifest_parent_mode < <(stat -Lc '%u %a' -- "${manifest_parent}") ||
  fail "cannot inspect manifest parent"
[[ "${manifest_parent_owner}" == "$(id -u)" ]] || fail "manifest parent must be owned by the current user"
(( (8#${manifest_parent_mode} & 8#022) == 0 )) || fail "manifest parent must not be group/other writable"

for role in "${ROLES[@]}"; do
  [[ "$(git cat-file -t "${COMMIT}:${DOCKERFILES[${role}]}" 2>/dev/null)" == "blob" ]] ||
    fail "pinned tree is missing a regular Dockerfile: ${DOCKERFILES[${role}]}"
done

tree_entries="$(git ls-tree -r "${COMMIT}")" || fail "cannot inspect pinned Git tree"
if awk '$1 == "160000" && $2 == "commit" { found = 1 } END { exit !found }' <<< "${tree_entries}"; then
  fail "pinned tree contains submodules; exact recursive export is not supported"
fi
lfs_policy="$({
  git ls-tree -r -z --name-only "${COMMIT}" |
    git check-attr -z --stdin --source="${COMMIT}" filter |
    node -e '
      const input = require("node:fs").readFileSync(0);
      const fields = input.toString("utf8").split("\0");
      if (fields.at(-1) === "") fields.pop();
      if (fields.length % 3 !== 0) process.exit(2);
      let found = false;
      for (let index = 0; index < fields.length; index += 3) {
        if (fields[index + 1] === "filter" && fields[index + 2] === "lfs") found = true;
      }
      process.stdout.write(found ? "lfs" : "none");
    '
})" || fail "cannot determine pinned tree Git LFS policy"
[[ "${lfs_policy}" == "none" ]] || fail "pinned tree contains Git LFS paths; exact object export is not supported"

print_command() {
  printf 'DRY-RUN:'
  printf ' %q' "$@"
  printf '\n'
}

if [[ "${DRY_RUN}" == true ]]; then
  printf 'DRY-RUN: export Git tree %q to %s\n' "${COMMIT}" '/PRIVATE/EXACT-CONTEXT'
  for role in "${ROLES[@]}"; do
    reference="${REPOSITORIES[${role}]}:${TAG}"
    print_command docker build \
      --iidfile "/PRIVATE/IID-${role}" \
      --file "/PRIVATE/EXACT-CONTEXT/${DOCKERFILES[${role}]}" \
      --label "${REVISION_LABEL}=${COMMIT}" \
      --label "${SOURCE_LABEL}=${SOURCE_URL}" \
      --tag "${reference}" "/PRIVATE/EXACT-CONTEXT"
  done
  log "dry run complete; no Docker command ran and no manifest was written"
  exit 0
fi

command -v docker >/dev/null 2>&1 || fail "docker is required"
command -v head >/dev/null 2>&1 || fail "head is required to bound image inspection evidence"

umask 077
PRIVATE_BUILD_ROOT="$(mktemp -d "${manifest_parent}/.dogfood-build.XXXXXX")" ||
  fail "cannot create private build root"
[[ "$(stat -Lc '%u:%a' -- "${PRIVATE_BUILD_ROOT}")" == "$(id -u):700" ]] ||
  fail "private build root is not owner-only"
BUILD_CONTEXT="${PRIVATE_BUILD_ROOT}/context"
mkdir -m 0700 -- "${BUILD_CONTEXT}"
git_directory="$(git rev-parse --absolute-git-dir)" || fail "cannot resolve Git object directory"
export_index="${PRIVATE_BUILD_ROOT}/export.index"
verify_index="${PRIVATE_BUILD_ROOT}/verify.index"
GIT_DIR="${git_directory}" GIT_INDEX_FILE="${export_index}" git read-tree "${COMMIT}" ||
  fail "cannot read pinned Git tree"
GIT_DIR="${git_directory}" GIT_INDEX_FILE="${export_index}" git checkout-index \
  --all --force --prefix="${BUILD_CONTEXT}/" || fail "cannot export pinned Git tree"
GIT_DIR="${git_directory}" GIT_INDEX_FILE="${verify_index}" git read-tree --empty ||
  fail "cannot initialize context verification index"
(
  cd "${BUILD_CONTEXT}"
  GIT_DIR="${git_directory}" GIT_INDEX_FILE="${verify_index}" GIT_WORK_TREE="${BUILD_CONTEXT}" \
    git add --all -- .
) || fail "cannot hash exported build context"
exported_tree="$(GIT_DIR="${git_directory}" GIT_INDEX_FILE="${verify_index}" git write-tree)" ||
  fail "cannot derive exported build tree"
expected_tree="$(git rev-parse "${COMMIT}^{tree}")" || fail "cannot resolve pinned tree ID"
[[ "${exported_tree}" == "${expected_tree}" ]] || fail "exported build context differs from pinned Git tree"
for role in "${ROLES[@]}"; do
  [[ -f "${BUILD_CONTEXT}/${DOCKERFILES[${role}]}" &&
    ! -L "${BUILD_CONTEXT}/${DOCKERFILES[${role}]}" ]] ||
    fail "exported context is missing a regular Dockerfile: ${DOCKERFILES[${role}]}"
done

for role in "${ROLES[@]}"; do
  reference="${REPOSITORIES[${role}]}:${TAG}"
  if docker image inspect "${reference}" >/dev/null 2>&1; then
    fail "immutable image tag already exists locally: ${reference}"
  fi
done

inspect_immutable_id() {
  local image_id="$1" reference="$2" repository="$3"
  local response evidence inspection_file
  inspection_file="${PRIVATE_BUILD_ROOT}/${image_id#sha256:}.inspect.json"
  if ! docker image inspect --format '{{json .}}' "${image_id}" |
    head -c 1048577 > "${inspection_file}"; then
    fail "cannot inspect immutable image ID ${image_id}"
  fi
  (($(stat -Lc '%s' -- "${inspection_file}") <= 1048576)) ||
    fail "immutable image inspection response exceeds 1 MiB"
  response="$(< "${inspection_file}")"
  evidence="$(node -e '
    const fs = require("node:fs");
    const [expectedId, expectedReference, expectedRepository, revision, source] = process.argv.slice(1);
    let value;
    try {
      value = JSON.parse(fs.readFileSync(0, "utf8"));
    } catch {
      throw new Error("response is not one JSON object");
    }
    if (!value || Array.isArray(value) || typeof value !== "object") throw new Error("response is not one JSON object");
    if (value.Id !== expectedId) throw new Error("inspection subject does not match iidfile");
    const labels = value.Config?.Labels;
    if (!labels || labels["org.opencontainers.image.revision"] !== revision) throw new Error("wrong revision label");
    if (labels["org.opencontainers.image.source"] !== source) throw new Error("wrong source label");
    if (!Array.isArray(value.RepoTags) || value.RepoTags.length !== 1 || value.RepoTags[0] !== expectedReference) {
      throw new Error("missing, floating, or mixed RepoTags");
    }
    if (!Array.isArray(value.RepoDigests)) throw new Error("RepoDigests is not an array");
    const prefix = `${expectedRepository}@sha256:`;
    for (const digest of value.RepoDigests) {
      if (typeof digest !== "string" || !digest.startsWith(prefix) || !/^[0-9a-f]{64}$/.test(digest.slice(prefix.length))) {
        throw new Error("unexpected RepoDigest");
      }
    }
    process.stdout.write(JSON.stringify([...new Set(value.RepoDigests)].sort()));
  ' "${image_id}" "${reference}" "${repository}" "${COMMIT}" "${SOURCE_URL}" <<< "${response}")" ||
    fail "${reference} has invalid immutable-ID inspection evidence"
  printf '%s' "${evidence}"
}

for role in "${ROLES[@]}"; do
  reference="${REPOSITORIES[${role}]}:${TAG}"
  iidfile="${PRIVATE_BUILD_ROOT}/${role}.iid"
  log "building ${role} as ${reference}"
  docker build \
    --iidfile "${iidfile}" \
    --file "${BUILD_CONTEXT}/${DOCKERFILES[${role}]}" \
    --label "${REVISION_LABEL}=${COMMIT}" \
    --label "${SOURCE_LABEL}=${SOURCE_URL}" \
    --tag "${reference}" "${BUILD_CONTEXT}"

  [[ -f "${iidfile}" && ! -L "${iidfile}" ]] || fail "${reference} did not write a regular iidfile"
  mapfile -t iid_lines < "${iidfile}"
  [[ "${#iid_lines[@]}" -eq 1 && "${iid_lines[0]}" =~ ^sha256:[0-9a-f]{64}$ ]] ||
    fail "${reference} wrote a non-canonical or mixed iidfile"
  image_id="${iid_lines[0]}"
  IMAGE_IDS[${role}]="${image_id}"
  IMAGE_DIGEST_JSON[${role}]="$(inspect_immutable_id \
    "${image_id}" "${reference}" "${REPOSITORIES[${role}]}")"
done

TEMP_MANIFEST="$(mktemp "${manifest_parent}/.dogfood-images.XXXXXX")" || fail "cannot create manifest temporary file"
{
  printf '{\n'
  printf '  "schema_version": 1,\n'
  printf '  "status": "COMPLETE",\n'
  printf '  "source": {"repository": "%s", "revision": "%s"},\n' "${SOURCE_URL}" "${COMMIT}"
  printf '  "tag": "%s",\n' "${TAG}"
  printf '  "images": [\n'
  for index in "${!ROLES[@]}"; do
    role="${ROLES[${index}]}"
    reference="${REPOSITORIES[${role}]}:${TAG}"
    printf '    {"name": "%s", "reference": "%s", "id": "%s", "repo_digests": ' \
      "${role}" "${reference}" "${IMAGE_IDS[${role}]}"
    printf '%s' "${IMAGE_DIGEST_JSON[${role}]}"
    printf ', "labels": {"%s": "%s", "%s": "%s"}}' \
      "${REVISION_LABEL}" "${COMMIT}" "${SOURCE_LABEL}" "${SOURCE_URL}"
    if (( index + 1 < ${#ROLES[@]} )); then printf ','; fi
    printf '\n'
  done
  printf '  ]\n'
  printf '}\n'
} > "${TEMP_MANIFEST}"
chmod 0600 "${TEMP_MANIFEST}"
[[ "$(stat -Lc '%a:%h' -- "${TEMP_MANIFEST}")" == "600:1" ]] || fail "temporary manifest is not mode-safe"

for role in "${ROLES[@]}"; do
  reference="${REPOSITORIES[${role}]}:${TAG}"
  resolved_id="$(docker image inspect --format '{{.Id}}' "${reference}")" ||
    fail "intended tag disappeared before COMPLETE handoff: ${reference}"
  [[ "${resolved_id}" == "${IMAGE_IDS[${role}]}" ]] ||
    fail "intended tag was retagged before COMPLETE handoff: ${reference}"
done
ln -- "${TEMP_MANIFEST}" "${MANIFEST}" || fail "manifest path was created concurrently"
rm -f -- "${TEMP_MANIFEST}"
TEMP_MANIFEST=
[[ "$(stat -Lc '%a:%h' -- "${MANIFEST}")" == "600:1" ]] || fail "published manifest is not mode 0600 with one link"
log "COMPLETE manifest written atomically: ${MANIFEST}"
