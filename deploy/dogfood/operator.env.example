# Copy outside the repository, chmod 0600, replace every placeholder, and pass
# it with docker compose --env-file. Never commit the resulting file.
SUMI_APP_SHA=<exact-main-commit>
SUMI_API_IMAGE=ghcr.io/sumi-studio/sumi-api@sha256:<digest>
SUMI_PROVISIONER_IMAGE=ghcr.io/sumi-studio/sumi-runtime-provisioner@sha256:<digest>
SUMI_POSTGRES_IMAGE=postgres:17-alpine@sha256:<digest>
SUMI_CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:<digest>

SUMI_CANONICAL_HOST=<host-without-scheme>
SUMI_CLOUDFLARE_ZONE=<zone-name>
SUMI_CLOUDFLARE_TUNNEL_TOKEN_FILE=/etc/sumi/secrets/cloudflare-tunnel-token
SUMI_DOGFOOD_STATE_ROOT=/srv/sumi/dogfood
SUMI_DOGFOOD_DOCKER_CONTEXT=default
SUMI_DOGFOOD_OPERATION_LOCK=/srv/sumi/dogfood/.operations.lock

SUMI_POSTGRES_PASSWORD_FILE=/etc/sumi/secrets/postgres-password
SUMI_DOCKER_CONFIG_FILE=/etc/sumi/docker/config.json
SUMI_DB_URL=postgres://sumi:<percent-encoded-password>@postgres:5432/sumi?sslmode=disable
SUMI_FIREBASE_ADC_FILE=/etc/sumi/secrets/firebase-adc.json
SUMI_AUTH_FIREBASE_PROJECT_ID=<firebase-project-id>

SUMI_LOCAL_CONTROL_TENANT_ID=<dogfood-tenant-id>
SUMI_AGENT_TOKEN_SECRET=<base64-32-byte-or-longer-secret>
SUMI_BROWSER_SESSION_SECRET=<base64-32-byte-or-longer-secret>
SUMI_APPROVAL_SECRET_DIGEST_KEY=<64-lowercase-hex>
SUMI_PROVIDER_API_KEY=<provider-api-key>
SUMI_MODEL_PRESET=kimi-k3
SUMI_MODEL_ID=

# #238 supplies the final LiveKit origin/credentials. Leave all three empty
# together while calls are unavailable; never partially configure them.
SUMI_LIVEKIT_URL=
SUMI_LIVEKIT_API_KEY=
SUMI_LIVEKIT_API_SECRET=
SUMI_MESSAGING_PUSH_SUBJECT=
