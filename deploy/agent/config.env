# T26 production deployment configuration for the Sumi agent supervisor.
# Source this file with the deploy/agent/supervisor script.
# All paths must be absolute; the supervisor will create missing directories
# and enforce ownership when running as root.

# User and group identities. In production these should be distinct system
# accounts (e.g. sumi-runtime, sumi-tool, sumi-artifact). Numeric IDs are also
# accepted. UID separation requires the supervisor to run as root or for the
# configured users to be mapped inside a user namespace via newuidmap.
SUMI_RUNTIME_USER=sumi-runtime
SUMI_RUNTIME_GROUP=sumi-runtime
SUMI_EXECUTOR_USER=sumi-tool
SUMI_EXECUTOR_GROUP=sumi-tool
SUMI_BROKER_USER=sumi-artifact
SUMI_BROKER_GROUP=sumi-artifact

# Persistent state and data roots.
SUMI_STATE_DIR=/var/lib/sumi
SUMI_AGENT_RUNTIME_STATE_DIR=/var/lib/sumi-runtime-state
SUMI_WORKSPACE=/var/lib/sumi/workspace
SUMI_ARTIFACT_ROOT=/var/lib/sumi/artifacts

# Unix-domain sockets used between runtime, executor and broker.
SUMI_EXECUTOR_SOCKET=/run/sumi/executor.sock
SUMI_ARTIFACT_BROKER_SOCKET=/run/sumi/broker.sock

# Isolation mode:
#   compose     - use the Docker Compose isolation harness (default).
#   low-trust   - local functional test only; never release evidence.
#   privileged/rootless process modes are fail-closed because they cannot
#                provide bash's disjoint broker-mount boundary.
SUMI_ISOLATION_MODE=compose

# When rootless mode cannot preserve UID separation, fail-closed unless this is
# set to 1. Low-trust mode is only for local functional testing and must not be
# used as production evidence.
SUMI_ALLOW_LOW_TRUST=0

# The runtime alone receives this provider credential. It is intentionally not
# inherited by executor or artifact-broker sidecars.
SUMI_PROVIDER_API_KEY=

# Runtime network configuration. The runtime needs external provider access;
# the executor and broker get a network namespace with no external interfaces.
# In privileged mode the supervisor can create a veth pair for the runtime.
SUMI_RUNTIME_NETWORK_NAMESPACE=
