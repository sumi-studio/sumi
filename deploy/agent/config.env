# Non-secret defaults for deploy/agent/supervisor. Caller environment wins.
SUMI_COMPOSE_TIMEOUT=30
SUMI_LOCAL_CONTROL_SOCKET_GID=10022
SUMI_MODEL_PRESET=kimi-k3
SUMI_LOG=sumi_agent=info

# The fixed /run/sumi/supervisor-locks root and every ancestor must be
# root-owned and non-writable by group/other. A root supervisor creates its
# per-PAID `sumi-${PAID-without-hyphens}.lock` automatically. For a non-root
# supervisor, provision that exact regular file in advance, owned by the
# supervisor uid with mode 0600 and nlink=1.
#
# Before launch, the dedicated local-control process must own:
#   /run/sumi/local-control/${PAID-without-hyphens}/ (0750)
#   .../control.sock (0660, nlink=1)
# with both paths owned by SUMI_LOCAL_CONTROL_SERVER_UID and grouped on
# SUMI_LOCAL_CONTROL_SOCKET_GID. The fixed /run/sumi/local-control root and
# every ancestor must be root-owned and non-writable by group/other. Configure
# that process with SUMI_LOCAL_CONTROL_ENABLED=1,
# SUMI_LOCAL_CONTROL_UNIX_SOCKET=<the host path above>, and the same decimal
# SUMI_LOCAL_CONTROL_SOCKET_GID. Runtime sees the socket at the fixed
# /run/sumi/local-control/control.sock container path, read-only.
#
# Required per launch (no legacy tenant/agent/conversation identifiers):
# SUMI_PERSONALITY_AGENT_ID=canonical-lowercase-uuidv7
# SUMI_GATEWAY_URL=wss://...
# SUMI_LOCAL_CONTROL_SERVER_UID=decimal uid of the dedicated Go server
# SUMI_LOCAL_CONTROL_BEARER=...
# SUMI_LOCAL_CONTROL_BEARER_EXPIRES_AT_UNIX=...
# SUMI_AGENT_WRAPPING_KEY=...
# SUMI_AGENT_WRAPPING_KEY_ID=...
# SUMI_APPROVAL_SECRET_DIGEST_KEY=...
# SUMI_PROVIDER_API_KEY=...
