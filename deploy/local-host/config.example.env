# sumi-local configuration reference.
#
# `sumi-local install` writes a populated version of this file to
# <state-home>/config.env (mode 0600). Everything marked generated is created
# once at install and then preserved across reinstalls — it is what makes the
# secretary the same individual after an update.

# Stable installation id — generated once at first install from the state
# home path, then recorded here forever. Managed docker resources are named
# after it (sumi-local-pg-<id>, sumi-local-pgdata-<id>, compose project
# sumi-local-<id>), which is what keeps two installs' data isolated.
# SUMI_LOCAL_ID='sl<hash>'

# The install prefix this state home belongs to. Lifecycle commands compare
# SUMI_LOCAL_PREFIX against it and refuse a mismatched pair rather than
# acting on two different installs at once. Rewritten by a reinstall that
# uses a different --prefix.
# SUMI_LOCAL_INSTALLED_PREFIX='/home/you/.local/lib/sumi-local'

# Bind for the state service + browser surface. Loopback literals only: the
# browser URL carries a capability credential, so wildcard binds are refused.
SUMI_LOCAL_LISTEN='127.0.0.1:8470'

# Database: 'external' uses SUMI_DB_URL; 'managed' runs a dedicated
# loopback-only postgres:17-alpine container per deploy/local-host/
# compose.pg.yaml under this install's own compose project.
SUMI_LOCAL_DB_MODE='managed'

# --- external mode ---------------------------------------------------------
# SUMI_DB_URL='postgres://user:pass@127.0.0.1:5432/dbname?sslmode=disable'

# --- managed mode (generated at install) -----------------------------------
# SUMI_LOCAL_PG_CONTAINER='sumi-local-pg-<id>'
# SUMI_LOCAL_PG_VOLUME='sumi-local-pgdata-<id>'
# SUMI_LOCAL_PG_PASSWORD='<generated>'
# Host bind for the managed PG. '127.0.0.1:0' = docker-assigned ephemeral
# port (resolved via `docker compose port` at each start); pin a fixed port
# only if you know it is free for this install's lifetime.
# SUMI_LOCAL_PG_LISTEN='127.0.0.1:0'

# --- identity (generated once at install, then preserved) -------------------
# Admin/service bearer for the state API. Persona and browser credentials are
# derived from it; rotating it invalidates them all.
# SUMI_CORE_STATE_TOKEN='<generated>'
# The secretary. Same id across restarts = same individual, same history.
# SUMI_PERSONA_ID='<uuidv7 generated at install>'
# SUMI_PERSONA_NAME='Sumi'

# --- model connection -------------------------------------------------------
# 'mock' echoes inputs — no credential, for trying the mechanics.
# 'openai' talks to an OpenAI-compatible chat-completions endpoint:
# SUMI_MODEL_PROVIDER='openai'
# SUMI_MODEL_BASE_URL='https://provider.example/v1'
# SUMI_MODEL_API_KEY='<your key>'
# SUMI_MODEL_MODEL='model-id'
# Optional: SUMI_MODEL_HEADERS_JSON='{"x-header":"v"}'  (static extra headers)
# Optional: SUMI_MODEL_EXTRA_JSON='{"max_tokens":2048}' (extra request fields)
# Optional: SUMI_MODEL_TIMEOUT_MS='120000'
# A ChatGPT/Codex subscription can be bridged manually — see
# docs/local-host.md "Model connection".

# --- operational knobs (may also be set in the environment per start) -------
# SUMI_LEASE_TTL_MS='30000'              # writer lease; bounds crash recovery
# SUMI_PROVIDER_RETRY_BUDGET_MS='1800000' # transient provider retry window
# SUMI_LOCAL_EXTRA_HOSTS='job-runner.ts'  # additional core hosts, when they
#                                         # land on main (jobs-results slice)
