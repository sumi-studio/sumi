#!/usr/bin/env bash
# sumi-files-check — verify that a path is a live mount of THE canonical
# Sumi files volume before anything reads or writes through it.
#
#   sumi-files-check [--wait SECONDS] MOUNTPOINT EXPECTED_VOLUME_UUID [SCOPE]
#
# Passes (exit 0) only when MOUNTPOINT is itself a fuse.juicefs mount of the
# volume root, answers (not ENOTCONN), serves the expected volume UUID and
# has zero metadata caching. With SCOPE, the scope directory must exist as a
# real directory; its absolute path is printed on stdout — that is the only
# path an executor may bind as its workspace.
#
# Every refusal prints one line "refused: <code>: <detail>" on stderr:
#   usage | not_mounted | wrong_fstype | subdir_mount | unreadable_config |
#   wrong_volume | cache_policy | scope_missing
# A bare directory left behind by a stopped mount is `not_mounted`, never a
# usable workspace: binding it would silently create a divergent copy.
set -uo pipefail

wait_s=0
if [[ "${1:-}" == "--wait" ]]; then
  wait_s="${2:-}"
  shift 2
fi
mnt="${1:-}"
want_uuid="${2:-}"
scope="${3:-}"

refuse() {
  echo "refused: $1: $2" >&2
  exit 2
}

[[ -n "$mnt" && -n "$want_uuid" ]] ||
  refuse usage "sumi-files-check [--wait S] MOUNTPOINT VOLUME_UUID [SCOPE]"
[[ "$wait_s" =~ ^[0-9]+$ ]] || refuse usage "--wait takes whole seconds"
[[ "$mnt" == /* && "$mnt" != */ && "$mnt" != *[[:space:]]* ]] ||
  refuse usage "MOUNTPOINT must be absolute, without trailing slash or whitespace"
if [[ -n "$scope" ]]; then
  [[ "$scope" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$scope" != *..* && "$scope" != .filesv-* ]] ||
    refuse usage "invalid scope name"
fi

# mountinfo fields: 1=id 4=root 5=mountpoint ... "-" fstype. The LAST entry
# for a mountpoint is the one a lookup reaches for ordinary stacking.
mount_entry() {
  awk -v mp="$mnt" '
    { sep = 0; for (i = 7; i <= NF; i++) if ($i == "-") { sep = i; break } }
    sep && $5 == mp { line = $4 " " $(sep + 1) }
    END { if (line != "") print line }' /proc/self/mountinfo
}

check_once() {
  local entry root fstype cfg uuid k v
  entry="$(mount_entry)"
  if [[ -z "$entry" ]]; then
    echo "not_mounted:no mount at $mnt"
    return 1
  fi
  read -r root fstype <<<"$entry"
  if [[ "$fstype" != "fuse.juicefs" ]]; then
    echo "wrong_fstype:$mnt is $fstype, not fuse.juicefs"
    return 1
  fi
  if [[ "$root" != "/" ]]; then
    echo "subdir_mount:$mnt mounts volume subdirectory $root, not the volume root"
    return 1
  fi
  if ! stat -- "$mnt" >/dev/null 2>&1; then
    echo "not_mounted:$mnt does not answer (dead FUSE daemon)"
    return 1
  fi
  if ! cfg="$(timeout 5 cat -- "$mnt/.config" 2>/dev/null)"; then
    echo "unreadable_config:$mnt/.config"
    return 1
  fi
  uuid="$(grep -o '"UUID": *"[^"]*"' <<<"$cfg" | head -1 | sed 's/.*"\([^"]*\)"$/\1/')"
  if [[ "$uuid" != "$want_uuid" ]]; then
    echo "wrong_volume:$mnt serves volume ${uuid:-unknown}, expected $want_uuid"
    return 1
  fi
  for k in AttrTimeout EntryTimeout DirEntryTimeout NegEntryTimeout; do
    v="$(grep -o "\"$k\": *[0-9.e+-]*" <<<"$cfg" | head -1 | sed 's/.*: *//')"
    if [[ -z "$v" ]] || ! awk -v x="$v" 'BEGIN { exit !(x == 0) }'; then
      echo "cache_policy:$k=${v:-missing} (mount with --attr-cache=0 --entry-cache=0 --dir-entry-cache=0 --negative-entry-cache=0)"
      return 1
    fi
  done
  return 0
}

deadline=$((SECONDS + wait_s))
while :; do
  if result="$(check_once)"; then
    break
  fi
  if ((SECONDS >= deadline)); then
    refuse "${result%%:*}" "${result#*:}"
  fi
  sleep 1
done

if [[ -n "$scope" ]]; then
  dir="$mnt/$scope"
  if [[ -L "$dir" || ! -d "$dir" ]]; then
    refuse scope_missing "$scope is not a directory on volume $want_uuid"
  fi
  printf '%s\n' "$dir"
fi
exit 0
