# Scoped file API over the service client's mount (user unit on the WSL alpha
# origin). Bound to that client: if the mount unit stops, filesvc stops with
# it; while the mount is merely absent (e.g. a manual remount)
# FILESV_REQUIRE_MOUNT=1 answers 503 mount_unavailable instead of writing
# into the bare directory. WantedBy on the mount unit restores filesvc when
# the client restarts after an ordinary crash — no manual start needed.
#   env file ~/.config/sumi-files/filesvc.env (0600):
#     FILESV_LISTEN FILESV_ROOT FILESV_DB_URL FILESV_TOKENS FILESV_REQUIRE_MOUNT=1
# FILESV_DB_URL may use a {docker:CONTAINER} host token; ExecStartPre resolves
# it to the container's current bridge IP into a fragment environment file
# (the address is runtime evidence, not durable configuration). --from reads
# the template env file afresh: a previous run's fragment (loaded into this
# process's environment by systemd before ExecStartPre runs) would otherwise
# shadow the token and freeze the resolved address.
[Unit]
Description=Sumi files API (filesvc)
Requires=sumi-files-mount@service.service
After=sumi-files-mount@service.service
PartOf=sumi-files-mount@service.service

[Service]
Type=simple
RuntimeDirectory=sumi-files
EnvironmentFile=%E/sumi-files/filesvc.env
ExecStartPre=/bin/bash -c 'test "$${FILESV_REQUIRE_MOUNT}" = 1 || { echo "refused: FILESV_REQUIRE_MOUNT must be 1 in Cloud placement" >&2; exit 2; }'
ExecStartPre=%h/.local/lib/sumi-files/sumi-files-resolve-url --env %t/sumi-files/filesvc-url.env --from %E/sumi-files/filesvc.env FILESV_DB_URL
EnvironmentFile=-%t/sumi-files/filesvc-url.env
ExecStart=%h/.local/lib/sumi-files/filesvc
Restart=on-failure
RestartSec=3
UMask=0022

[Install]
WantedBy=default.target sumi-files-mount@service.service
