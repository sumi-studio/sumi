# Copy to deploy/local/.env.local (ignored by Git), then fill every required
# blank. Values are literal: do not add shell quotes or `export`.

# Exact native-stack bind. Keep the default for host-only development. To
# access from another Tailnet device, replace it with this host's assigned
# Tailscale IPv4 address. Hostnames and wildcard addresses are rejected.
SUMI_PUBLIC_LISTEN=127.0.0.1:8080
# compose-stack reuses the host part of SUMI_PUBLIC_LISTEN. Set this only when
# the Compose bind should differ; it takes precedence and uses no port suffix.
# SUMI_DEV_BIND_HOST=127.0.0.1

# Compose pulls Sumi images from GHCR on every start. Each `latest` identifies
# that service's most recent completed push; parallel Jenkins branches can
# advance only some services if another branch fails. For a coordinated release,
# pin all five services independently to their known-published short commit SHA
# tags. Run `docker login ghcr.io` on the Compose host first when the packages
# are private.
# SUMI_API_IMAGE_TAG=latest
# SUMI_AGENT_IMAGE_TAG=latest
# SUMI_PROVISIONER_IMAGE_TAG=latest
# SUMI_WEB_IMAGE_TAG=latest
# SUMI_FIREBASE_IMAGE_TAG=latest
# Required by `scripts/dev/compose-stack up` when GHCR images are private.
# Point to the exact config.json created by `docker login ghcr.io`; the launcher
# requires a current-user-owned regular 0400/0600 file and mounts only it
# read-only into runtime-provisioner. Do not provide a Docker config directory.
# SUMI_DOCKER_CONFIG_FILE=/absolute/path/to/config.json

# Development database. Unset (default) means the launcher starts the
# compose-managed development Postgres itself. Set this only to point at an
# owned, already running database you manage; the API still validates
# connectivity and applies migrations on startup.
# SUMI_DEV_DATABASE_URL=postgres://sumi:sumi-dev@127.0.0.1:5432/sumi?sslmode=disable

# Runtime selection. `make dev` keeps the working tool-executor +
# PersonalityAgent launch (it needs a Rust toolchain and the model/reviewer
# variables below). The `core` setting — `make dev-core` — runs each
# secretary on the accepted TypeScript core (apps/core): the API mounts its
# state service, serves Messaging and Direct Chat through durable core
# state, and a local dev pool runs one Node host per secretary, woken by the
# API's sweep.
# SUMI_DEV_RUNTIME=core
# The dev pool's wake listener (127.0.0.1 loopback only) defaults to :8083.
# SUMI_DEV_POOL_LISTEN=127.0.0.1:8083

# Core model provider (SUMI_DEV_RUNTIME=core only). The default `mock` is a
# deterministic network-free provider: it answers inputs without any
# credential, so no paid account is needed for development. `fixture` runs
# scripted rules from SUMI_MODEL_FIXTURE (a JSON file path) or
# SUMI_MODEL_FIXTURE_JSON (inline JSON); `openai` needs SUMI_MODEL_BASE_URL,
# SUMI_MODEL_API_KEY and SUMI_MODEL_MODEL for an OpenAI-compatible endpoint
# (a local stub accepts any non-empty key); `none` disables model calls while
# durable tools still run. A model connection selected in the app overrides
# these environment values.
# SUMI_MODEL_PROVIDER=mock
# SUMI_MODEL_BASE_URL=
# SUMI_MODEL_API_KEY=
# SUMI_MODEL_MODEL=

# One configured PersonalityAgent. This exact UUIDv7 is shared by the browser
# authorization binding, local control plane, executor, and Rust runtime.
# Required by `--runtime rust` (the `make dev` default); the core runtime
# derives each secretary's persona from the signed-in human's registration.
SUMI_PERSONALITY_AGENT_ID=0198f0f4-9b72-7000-8000-000000000001

# Firebase Admin and the built-in web client both default to the sumi-studio
# project. GOOGLE_APPLICATION_CREDENTIALS is read from the invoking environment
# so a credential path is never stored in this file. gcloud ADC is also
# supported when that variable is absent.
SUMI_AUTH_FIREBASE_PROJECT_ID=sumi-studio
# Deprecated single-user binding (ADR 0009 §8). Leave blank for multi-user mode:
# the 戸籍-backed resolver auto-registers any verified Firebase identity. When
# set, the legacy StaticIdentityBindingResolver gates on this exact UID.
SUMI_AUTH_FIREBASE_UID=
# Leave blank for a normal (non-Identity-Platform-tenant) Firebase user.
SUMI_AUTH_FIREBASE_TENANT_ID=

# Email sign-in (6-digit code first, emailed link as an alternative). The
# channel stays off unless all four enabling variables are set together.
# SUMI_AUTH_EMAIL_CHALLENGE_KEY is base64 for at least 32 bytes (generate:
# openssl rand -base64 32); rotating the key or its ID expires outstanding
# codes and links. SUMI_AUTH_EMAIL_LINK_ORIGIN must equal one of the allowed
# browser origins — locally the Vite origin, publicly the deployed SPA origin.
# SUMI_AUTH_EMAIL_CHALLENGE_KEY=
# SUMI_AUTH_EMAIL_CHALLENGE_KEY_ID=
# SUMI_AUTH_EMAIL_LINK_ORIGIN=
#
# Local development sender: writes each message as an owner-only JSON file
# instead of sending mail. Accepted only with insecure local cookies or the
# Firebase Auth emulator.
# SUMI_AUTH_EMAIL_SENDER=dev-mailbox
# SUMI_AUTH_EMAIL_DEV_MAILBOX_DIR=/absolute/path/to/mailbox
#
# Production sender: authenticated TLS SMTP submission. HOST is a bare host
# name or IP (no port); TLS is "starttls" (default, port 587) or "implicit"
# (SMTPS, port 465 — implied when PORT=465 and TLS is unset). The password
# comes from exactly one source; the file form keeps the secret out of the
# environment. FROM is an RFC 5322 mailbox. Example placeholders fit common
# providers (a Resend submission would use smtp.resend.com, user "resend",
# password = API key).
# SUMI_AUTH_EMAIL_SENDER=smtp
# SUMI_AUTH_EMAIL_SMTP_HOST=smtp.example.com
# SUMI_AUTH_EMAIL_SMTP_TLS=starttls
# SUMI_AUTH_EMAIL_SMTP_PORT=587
# SUMI_AUTH_EMAIL_SMTP_USERNAME=apikey
# SUMI_AUTH_EMAIL_SMTP_PASSWORD=
# SUMI_AUTH_EMAIL_SMTP_PASSWORD_FILE=/absolute/path/to/smtp-password
# SUMI_AUTH_EMAIL_SMTP_FROM=Sumi <login@example.com>

# Deployment provenance tenant for browser session claims. Required in both
# single-user and multi-user (戸籍) modes.
SUMI_AUTH_TENANT_ID=local
# Deprecated single-user binding (ADR 0009 §8). Ignored in multi-user mode,
# where the HumanId is resolved from the 戸籍.
SUMI_AUTH_USER_ID=
# Optional, but if set it must equal SUMI_PERSONALITY_AGENT_ID.
SUMI_AUTH_PERSONALITY_AGENT_ID=

# Participants who receive submitted Sumi Feedback (comma-separated typed IDs).
# Empty leaves the destination unavailable; it does not expose reports publicly.
# Example: human:<Human UUIDv7>,personality_agent:<PersonalityAgent UUIDv7>
SUMI_FEEDBACK_RECIPIENTS=

# Optional explicit external Firebase Auth emulator for the native real-stack.
# compose-stack starts and persists its own integrated emulator by default:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# `scripts/dev/compose-stack --firebase real up` instead requires a current-user
# owned 0400/0600 ADC file. The launcher validates it and a networkless init
# service stages a UID-65532-readable runtime copy without weakening this file.
# SUMI_FIREBASE_ADC_FILE=/absolute/path/to/application_default_credentials.json

# Real model provider for the Rust runtime (`--runtime rust` only; the core
# runtime reads SUMI_MODEL_PROVIDER above). The named credential variable
# must also be defined.
SUMI_MODEL_PRESET=opencode-go
SUMI_MODEL_API_KEY_ENV=OPENCODE_GO_API_KEY
# Required before a provisioned PersonalityAgent can start. Supply two
# structured-output-capable reviewer providers with distinct origins and
# separate credential sources; this template deliberately does not choose them.
SUMI_EXECUTION_REVIEWER_MODEL_PRESET=
SUMI_EXECUTION_REVIEWER_MODEL_API_KEY_ENV=SUMI_EXECUTION_REVIEWER_API_KEY
SUMI_EXECUTION_REVIEWER_API_KEY=
SUMI_ESCALATION_REVIEWER_MODEL_PRESET=
SUMI_ESCALATION_REVIEWER_MODEL_API_KEY_ENV=SUMI_ESCALATION_REVIEWER_API_KEY
SUMI_ESCALATION_REVIEWER_API_KEY=
OPENCODE_GO_API_KEY=

# Optional exact model override:
# SUMI_MODEL_ID=kimi-k2.7-code
#
# Codex OAuth bridge alternative (no public OpenAI API key):
# SUMI_MODEL_PRESET=openai-responses
# SUMI_MODEL_ID=gpt-5.6-sol
# SUMI_MODEL_BASE_URL=http://127.0.0.1:8765/v1
# SUMI_MODEL_API_KEY_ENV=SUMI_CODEX_RESPONSES_PROXY_SECRET
