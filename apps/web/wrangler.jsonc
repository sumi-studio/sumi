{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "sumi-web",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "global_fetch_private_origin",
    "enable_request_signal",
    "request_signal_passthrough"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "env": {
    "alpha": {
      "name": "sumi-alpha",
      "workers_dev": true,
      "preview_urls": false,
      "compatibility_flags": [
        "enable_request_signal",
        "request_signal_passthrough"
      ],
      "vpc_services": [
        {
          "binding": "SUMI_ORIGIN",
          "service_id": "01a09449-94f3-7fc3-b6db-daaffb98df22"
        }
      ],
      "services": [
        {
          "binding": "SUMI_BROWSER_CLOUD",
          "service": "sumi-browser-alpha"
        }
      ],
      "vars": {
        "SUMI_ORIGIN_PROTOCOL": "http",
        "SUMI_FIREBASE_AUTH_DOMAIN": "sumi-studio.firebaseapp.com"
      }
    },
    // Isolated proof of the WSL-independent API: the same Web Worker, with
    // SUMI_ORIGIN bound to the api-container Worker instead of the VPC
    // Service that tunnels to the WSL host. See docs/operations/cloud-api-container.md.
    "proof": {
      "name": "sumi-proof",
      "workers_dev": true,
      "preview_urls": false,
      "compatibility_flags": [
        "enable_request_signal",
        "request_signal_passthrough"
      ],
      "services": [
        { "binding": "SUMI_ORIGIN", "service": "sumi-api-proof" }
      ],
      "vars": {
        "SUMI_ORIGIN_PROTOCOL": "http",
        "SUMI_FIREBASE_AUTH_DOMAIN": "sumi-studio.firebaseapp.com"
      }
    }
  }
}
