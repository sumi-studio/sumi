    "@sumi/ui": "workspace:*",
    "@tanstack/react-router": "^1.170.18",
    "firebase": "^12.16.0",
    "gen-interface-jp": "^0.7.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/vite": "^4.3.2",
