{
  "name": "@sumi/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/write-release-manifest.mjs",
    "check-types": "tsc -b --noEmit && pnpm run check-types:edge",
    "check-types:edge": "tsc -p cloudflare/tsconfig.json --noEmit",
    "test": "pnpm run test:ui && pnpm run test:runtime && pnpm run test:socket && pnpm run test:config",
    "test:edge": "pnpm run check-types:edge && pnpm run test:edge:contracts && pnpm run test:edge:runtime",
    "test:edge:contracts": "tsx --test scripts/cloudflare-edge.test.ts",
    "test:edge:artifact": "tsx --test scripts/production-artifact.test.ts",
    "test:edge:runtime": "tsx --test scripts/production-runtime-suite.ts",
    "test:edge:runtime:only": "tsx --test scripts/cloudflare-runtime.test.ts",
    "test:unit": "pnpm run test:ui && pnpm run test:runtime",
    "test:ui": "vitest run",
    "test:runtime": "tsx --test src/agent/reducer.test.ts src/agent/store.test.ts src/agent/history.test.ts src/agent/projector.test.ts",
    "test:socket": "tsx --test scripts/direct-chat-socket.test.mjs",
    "test:config": "tsx --test scripts/vite-config.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:workspace": "playwright test e2e/workspace-browser.spec.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sumi/api-client": "workspace:*",
    "@sumi/sdui": "workspace:*",
    "@sumi/ui": "workspace:*",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-virtual": "3.14.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "firebase": "^12.19.0",
    "gen-interface-jp": "^0.7.0",
    "livekit-client": "^2.23.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
