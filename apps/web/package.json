    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.2",
    "tsx": "4.23.1",
    "typescript": "~6.0.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
