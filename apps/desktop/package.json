{
  "name": "@sumi/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "exports": {
    "./browser": "./dist/browser/runtime.js",
    "./browser-contract": "./dist/browser/contract.js",
    "./browser-host": "./dist/browser/host.js",
    "./browser-goal": "./dist/browser/goal.js",
    "./browser-jev": "./dist/browser/jev.js",
    "./browser-page": "./dist/browser/page.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:browser": "pnpm build && electron test/acceptance.mjs",
    "test:browser:jev": "pnpm build && electron test/jev-acceptance.mjs",
    "dev:browser": "pnpm build && electron dist/browser-dev.js",
    "dev:browser:connected": "pnpm build && electron dist/browser-connected.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "44.9.1",
    "typescript": "~6.0.3"
  }
}
