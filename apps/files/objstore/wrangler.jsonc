{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "sumi-fabric-obj",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "BUCKET", "class_name": "BucketObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BucketObject"] }],
  "vars": {}
}
