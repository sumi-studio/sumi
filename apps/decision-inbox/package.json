{
  "name": "@sumi/decision-inbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && vite build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "build:web": "vite build",
    "check-types": "tsc -b --noEmit",
    "dev": "vite",
    "dev:worker": "pnpm run build:web && wrangler dev",
    "d1:local": "wrangler d1 migrations apply sumi-decision-inbox --local",
    "d1:remote": "wrangler d1 migrations apply sumi-decision-inbox --remote",
    "deploy": "pnpm run build:web && wrangler deploy",
    "deploy:dry-run": "pnpm run build:web && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "preview:smoke": "node scripts/smoke-server.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@playwright/test": "1.57.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "~6.0.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.36.0"
  }
}
