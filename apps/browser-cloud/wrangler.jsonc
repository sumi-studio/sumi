{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "sumi-browser",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [{ "name": "PROFILE", "class_name": "ProfileBrowser" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProfileBrowser"] }],
  "vars": {
    // Local wrangler dev only: the loopback Sumi API. wrangler dev has no
    // Browser Run acquire(); set LOCAL_POOL in .dev.vars to use
    // scripts/local-pool.mjs (local Chrome, not Cloud evidence).
    "SUMI_STATE_URL": "http://127.0.0.1:8080",
    "SUMI_BROWSER_IDLE_GRACE_MS": "60000",
    "SUMI_BROWSER_KEEPALIVE_MS": "60000"
  },
  "env": {
    // Public alpha browser host. The Sumi API reaches it over workers.dev
    // (POST /profiles/:id/wake only, bearer SUMI_BROWSER_CLOUD_TOKEN); the
    // sumi-alpha web edge reaches the viewer through its SUMI_BROWSER_CLOUD
    // service binding. Canonical state stays in the Go API.
    // Secret (wrangler secret put --env alpha):
    //   SUMI_BROWSER_CLOUD_TOKEN = the API's SUMI_BROWSER_CLOUD_TOKEN
    "alpha": {
      "name": "sumi-browser-alpha",
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": true },
      "browser": { "binding": "BROWSER" },
      "durable_objects": {
        "bindings": [{ "name": "PROFILE", "class_name": "ProfileBrowser" }]
      },
      "vpc_services": [
        {
          // sumi-alpha-api: http 100.116.25.99:8080 via sumi-alpha-tunnel.
          "binding": "SUMI_STATE",
          "service_id": "01a09449-94f3-7fc3-b6db-daaffb98df22"
        }
      ],
      "vars": {
        // Host header / path base only: the VPC Service decides where the
        // request goes.
        "SUMI_STATE_URL": "http://100.116.25.99:8080",
        "SUMI_BROWSER_IDLE_GRACE_MS": "60000",
        "SUMI_BROWSER_KEEPALIVE_MS": "60000"
      }
    }
  }
}
