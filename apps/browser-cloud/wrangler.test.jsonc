{
  // Test configuration only (never the product): the same Worker plus the
  // synthetic fixture site reached by the remote browser through Browser
  // Run's outboundByHost -> the FixtureSite entrypoint (no public DNS, no
  // public route). Deploy only under an isolated name:
  //   wrangler deploy -c wrangler.test.jsonc   (name must stay as below: the
  //   FIXTURE service binding points at itself)
  // Secret: SUMI_BROWSER_CLOUD_TOKEN (test value). SUMI_STATE_URL is passed
  // with --var at deploy time (the isolated test API).
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "sumi-cloud-browser-test-20260927",
  "main": "./fixture/test-worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "browser": { "binding": "BROWSER" },
  "services": [
    { "binding": "FIXTURE", "service": "sumi-cloud-browser-test-20260927", "entrypoint": "FixtureSite" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PROFILE", "class_name": "ProfileBrowser" },
      { "name": "FIXTURE_STATE", "class_name": "FixtureState" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProfileBrowser", "FixtureState"] }],
  "observability": { "enabled": true },
  "vars": {
    "SUMI_STATE_URL": "http://127.0.0.1:19410",
    "SUMI_BROWSER_IDLE_GRACE_MS": "20000",
    "SUMI_BROWSER_KEEPALIVE_MS": "30000",
    "FIXTURE_HOSTS": "app.sumi-fixture.test,docs.sumi-fixture.test"
  }
}
