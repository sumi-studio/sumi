{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "sumi-core",
  "main": "./src/host/workerd.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["global_fetch_private_origin"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "SECRETARY", "class_name": "SecretaryObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SecretaryObject"] }],
  "vars": {
    // Dev defaults — production values come from secrets/bindings.
    "SUMI_STATE_URL": "http://127.0.0.1:8180",
    "SUMI_MODEL_PROVIDER": "mock"
  }
}
