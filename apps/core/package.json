{
  "name": "@sumi/agent-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node scripts/e2e-local.mjs",
    "test:e2e:plan": "node scripts/e2e-plan.mjs",
    "test:e2e:memory": "node scripts/e2e-memory.mjs",
    "test:e2e:jobs": "node scripts/e2e-jobs.mjs",
    "test:e2e:workerd": "node scripts/e2e-workerd.mjs",
    "test:e2e:workerd:memory": "node scripts/e2e-workerd-memory.mjs",
    "test:e2e:portable": "node scripts/e2e-portable.mjs",
    "test:e2e:portable:memory": "node scripts/e2e-portable-memory.mjs",
    "dev:local": "node src/host/local.ts",
    "dev:pool": "node src/host/dev-pool.ts",
    "dev:job-runner": "node src/host/job-runner.ts",
    "dev:worker": "wrangler dev --config wrangler.jsonc",
    "dev:call-runner": "node src/host/call-runner.ts"
  },
  "devDependencies": {
    "@sumi/typescript-config": "workspace:*",
    "@types/node": "^24.13.2",
    "typescript": "~6.0.3",
    "wrangler": "4.120.1"
  },
  "dependencies": {
    "@livekit/rtc-node": "0.13.23"
  }
}
